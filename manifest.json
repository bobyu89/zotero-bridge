{
  "manifest_version": 2,
  "name": "ZotMax",
  "version": "0.13.0",
  "description": "A literature plugin for Zotero: structured notes with Claude or OpenAI, and items, annotations and notes synced to Notion and Obsidian, routed per library/collection.",
  "homepage_url": "https://github.com/bobyu89/zotero-bridge",
  "author": "BOB",
  "icons": {
    "48": "content/icons/bridge.svg",
    "96": "content/icons/bridge.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-bridge@bobyu89.github.io",
      "update_url": "https://raw.githubusercontent.com/bobyu89/zotero-bridge/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.*"
    }
  }
}
